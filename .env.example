# --- APA 7 Document Auditor — environment configuration ---------------------
# Copy to .env (or set in your shell / docker-compose). Never commit secrets.

# Runtime environment: development | production
APP_ENV=development

# Product name shown in logs / report footer (frontend name lives in web/src/App.tsx)
PRODUCT_NAME=APA 7 Document Auditor

# HTTP port for the API server (also serves the built frontend)
PORT=8000

# Maximum upload size in bytes (default 25 MB)
MAX_UPLOAD_SIZE=26214400

# How long uploaded/processed files are kept before automatic deletion
FILE_RETENTION_MINUTES=60

# Directory for temporary document storage (default: OS temp dir subfolder)
#STORAGE_DIR=/var/lib/apa7-auditor

# --- External metadata verification -----------------------------------------
# Provider: crossref | none
METADATA_PROVIDER=crossref
CROSSREF_BASE_URL=https://api.crossref.org
# Contact email sent in the Crossref User-Agent (recommended by Crossref's
# "polite pool" policy; optional)
CROSSREF_MAILTO=
CROSSREF_TIMEOUT_MS=8000
# Cap on Crossref requests per processing run (rate-limit friendliness)
CROSSREF_MAX_REQUESTS_PER_RUN=25

# --- Rate limiting ------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60

# --- Frontend -----------------------------------------------------------------
# Where the built frontend lives (served statically by the server)
#FRONTEND_DIST_DIR=/app/web/dist
# Dev-only: the Vite dev server proxies /api to this URL
#API_URL=http://localhost:8000

# --- Vercel deployment (all optional) -----------------------------------------
# The server/src/store/sessions.ts store auto-detects these at runtime. When
# they are absent (e.g. local dev, `npm test`) the store falls back to an
# in-memory Map + local temp files, exactly as before — you do not need to
# set any of these to run the app locally.
#
# Vercel KV (session metadata). Populated automatically in the Vercel
# dashboard when you attach a KV store to the project (Storage tab →
# Create Database → KV, then Connect to the project) — you normally never
# set these by hand.
#KV_REST_API_URL=
#KV_REST_API_TOKEN=
#KV_URL=
#
# Vercel Blob (original/output .docx binaries). Populated automatically
# when you attach Blob storage to the project (Storage tab → Create
# Database → Blob, then Connect to the project).
#BLOB_READ_WRITE_TOKEN=

# --- Document Merger (PDF rendering) -------------------------------------------
# The Document Merger (server/src/merge) renders merged .docx submissions to
# PDF with puppeteer-core. On Vercel (and any AWS Lambda-based host) it
# launches the bundled @sparticuz/chromium binary automatically — no setup
# needed. Locally it looks for an installed Google Chrome or Microsoft Edge
# in the usual OS install locations. If neither is found (or you want to
# point at a specific browser), set this to that browser's executable path:
#PUPPETEER_EXECUTABLE_PATH=
