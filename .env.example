# --- APA 7 Document Auditor — environment configuration ---------------------
# Copy to .env (or set in your shell / docker-compose). Never commit secrets.

# Runtime environment: development | production
APP_ENV=development

# Product name shown in logs / report footer (frontend name lives in web/src/App.tsx)
PRODUCT_NAME=APA 7 Document Auditor

# HTTP port for the API server (also serves the built frontend)
PORT=8000

# Maximum upload size in bytes (default 25 MB)
MAX_UPLOAD_SIZE=26214400

# How long uploaded/processed files are kept before automatic deletion
FILE_RETENTION_MINUTES=60

# Directory for temporary document storage (default: OS temp dir subfolder)
#STORAGE_DIR=/var/lib/apa7-auditor

# --- External metadata verification -----------------------------------------
# Provider: crossref | none
METADATA_PROVIDER=crossref
CROSSREF_BASE_URL=https://api.crossref.org
# Contact email sent in the Crossref User-Agent (recommended by Crossref's
# "polite pool" policy; optional)
CROSSREF_MAILTO=
CROSSREF_TIMEOUT_MS=8000
# Cap on Crossref requests per processing run (rate-limit friendliness)
CROSSREF_MAX_REQUESTS_PER_RUN=25

# --- Rate limiting ------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60

# --- Frontend -----------------------------------------------------------------
# Where the built frontend lives (served statically by the server)
#FRONTEND_DIST_DIR=/app/web/dist
# Dev-only: the Vite dev server proxies /api to this URL
#API_URL=http://localhost:8000
